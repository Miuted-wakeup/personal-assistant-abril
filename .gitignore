# Entornos virtuales de Python
venv/
env/
.venv/

# Variables de entorno (API Keys, Tokens)
.env
.env.local

# Archivos de Cache de Python
__pycache__/
*.py[cod]
*$py.class

# Bases de datos locales
data/chromadb/

# Archivos de Log
logs/
*.log

# Assets multimedia pesados (modelos, audios, videos grandes)
assets/videos/*.mp4
assets/videos/*.mkv
assets/*.onnx
assets/*.pth
assets/*.bin
assets/voices/*.onnx
assets/voices/*.pth
assets/voices/*.bin

# Configuraciones de IDEs y OS
.vscode/
.idea/
.DS_Store

# Rust
rust-voice-service/target/
**/*.rs.bk

# Basura de Windows
Thumbs.db
desktop.ini

# Archivos de Audio Temporales
*.wav
*.mp3
!assets/voices/*.wav
!assets/voices/*.mp3

# Bases de datos SQLite y Temporales
*.sqlite3
*.db

# Caché y Tests de Python extra
